# Copy this file to .env — the key below is pre-filled so the chatbot works
# out of the box for judging/evaluation, no OpenRouter account needed:
#
#   cp .env.example .env
#
# This is a disposable key provided only for this submission — it will be
# revoked after judging and should not be reused elsewhere. If you're
# continuing development past the competition, replace it with your own key
# from https://openrouter.ai/settings/integrations.
OPENROUTER_API_KEY=your_openrouter_api_key_here
